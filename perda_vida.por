programa
{
	inteiro vida = 100
	inteiro dano
	
		funcao perVid(){

			escreva("Quanto de dano ce tomou caba? ")
			leia(dano)
			
			vida = vida - dano
		}
	




	
	funcao inicio()
	{
		perVid()

		escreva("Sua vida agora e de ", vida)
	}
}
